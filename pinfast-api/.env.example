NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Neon pooled connection for the application (acrescente &pgbouncer=true&connect_timeout=15).
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Neon direct connection used by migrations.
DIRECT_URL=postgresql://user:password@host/database?sslmode=require

JWT_ACCESS_SECRET=replace-with-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:8443
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Cloudflare R2 (S3-compatible).
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_FORCE_PATH_STYLE=false
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=pinfast
R2_PUBLIC_URL=
MAX_UPLOAD_BYTES=10485760

# Cookies de sessão: com frontend e API em sites diferentes use COOKIE_SECURE=true e COOKIE_SAME_SITE=none.
# Cota total de anexos por usuário (bytes) e documentação Swagger (/docs) em produção.
USER_STORAGE_QUOTA_BYTES=209715200
ENABLE_DOCS=false

# Recuperação de senha por e-mail (Resend) e fechamento de cadastros.
RESEND_API_KEY=
MAIL_FROM=
APP_URL=http://localhost:8443
REGISTRATION_ENABLED=true
